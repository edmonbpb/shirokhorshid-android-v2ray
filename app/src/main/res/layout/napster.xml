<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/napster_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/napster_select_hint"
        android:textSize="14sp"
        android:textStyle="bold" />

    <Switch
        android:id="@+id/napster_switch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/napster_enable" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/napster_add"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/napster_add_file" />

        <Button
            android:id="@+id/napster_test"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/napster_test" />

        <Button
            android:id="@+id/napster_delete"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/napster_delete" />
    </LinearLayout>

    <Button
        android:id="@+id/napster_ping_all"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/napster_ping_all" />

    <Button
        android:id="@+id/napster_check_all"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/napster_check_all" />

    <Switch
        android:id="@+id/napster_auto_check"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/napster_auto_check" />

    <TextView
        android:id="@+id/napster_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/napster_empty"
        android:visibility="gone" />

    <ListView
        android:id="@+id/napster_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:choiceMode="singleChoice" />
</LinearLayout>
